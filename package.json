{
  "name": "base62str",
  "version": "2.0.0",
  "description": "Encode a string into a base62 string.  Decode a base62 string back to a decoded string. It can also code arrays of bytes.",
  "keywords": [
    "base62",
    "base-62",
    "encoding",
    "decoding",
    "url-encoding"
  ],
  "main": "dist/index.js",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.global.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "postbuild": "node scripts/patch-cjs-default.mjs",
    "test": "npm run build && vitest run",
    "test:watch": "vitest",
    "demo:dev": "vite",
    "demo:build": "vite build",
    "prepublishOnly": "npm run test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/felipecarrillo100/base62str"
  },
  "author": "Felipe Carrillo",
  "license": "MIT",
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsup": "^9.0.0",
    "typescript": "^6.0.3",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  }
}
